{
  "name": "shadow-ai-privacy-auditor",
  "version": "1.4.0",
  "description": "Local-only privacy auditor that finds and redacts sensitive information before it reaches an AI assistant. Chrome extension, command line, Claude Code hook and web app.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=18" },
  "bin": { "shadow-ai": "cli/shadow-ai.mjs" },
  "files": ["cli/", "engine/", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "test": "node tests/run.js && node tests/security.js && node tests/cli.js",
    "test:security": "node tests/security.js",
    "test:cli": "node tests/cli.js",
    "test:report": "node tests/run.js --write-report",
    "bench": "node tests/bench.js",
    "verify:offline": "node tools/verify-offline.mjs",
    "build:extension": "node tools/build-extension.mjs",
    "build": "npm run build:extension && npm run test:report",
    "store:package": "npm run build:extension && node tools/package-extension.mjs",
    "store:shots": "node tools/make-store-shots.mjs",
    "serve": "node tools/serve.mjs"
  },
  "keywords": ["privacy", "pii", "redaction", "dlp", "shadow-ai", "gdpr", "hipaa", "chrome-extension", "cli", "claude-code", "secrets"]
}
